# ==============================================================================
# Production RAG - Environment Configuration
# Developer-Agnostic | Local-First | Pluggable Providers
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Generation Provider
# Options: auto | ollama | openai | anthropic | gemini | groq | deepseek | mock
# "auto" will select the best provider based on available keys, falling back to
# local Ollama or Mock generator if no API keys are provided (zero-touch run).
# ------------------------------------------------------------------------------
GENERATION_PROVIDER=auto

# Ollama (100% Offline & Private - No API Key Needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI / OpenAI-Compatible (vLLM, LocalAI, Together, DeepSeek)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq / DeepSeek
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 2. Embedding & Reranking Models
# Local ONNX models run on CPU with zero network egress.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=local          # local (ONNX CPU) | openai | gemini | ollama
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

RERANKER_PROVIDER=local           # local (ONNX CPU) | cohere | none
LOCAL_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

EVALUATOR_PROVIDER=local          # local | none

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 4. Chunking & Ingestion
# ------------------------------------------------------------------------------
CHUNKING_STRATEGY=auto            # auto | fixed | page | code | semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=75
DESCRIBE_IMAGES=false             # Ingestion-time chart/image descriptions

UPLOAD_DIR=uploads
WORKER_POLL_SECONDS=2.0

# ------------------------------------------------------------------------------
# 5. Hybrid Retrieval & Semantic Cache
# ------------------------------------------------------------------------------
TOP_K_RETRIEVAL=20                # Top candidates per method (Dense & FTS)
TOP_K_RERANKED=5                  # Chunks passed to final generation
RRF_CONSTANT=60                   # Reciprocal Rank Fusion constant
HNSW_EF_SEARCH=80
# Permission-scoped dense search (keeps recall up for small teams)
EXACT_SCAN_MAX_ROWS=10000         # Visible chunks at or below this: exact scan, no HNSW
HNSW_ITERATIVE_SCAN=true          # pgvector >= 0.8: keep walking the graph until top_k pass the filter
HNSW_MAX_SCAN_TUPLES=20000        # Iterative scan stop point
HNSW_EF_SEARCH_MAX=400            # Older pgvector: one retry at this ef_search when results run short

SIMILARITY_THRESHOLD=0.95         # Semantic cache match threshold (0.0 - 1.0)
CACHE_TTL_HOURS=168               # 7-day TTL

# ------------------------------------------------------------------------------
# 6. Security & Multi-Tenant Access Control
# ------------------------------------------------------------------------------
PLATFORM_BOOTSTRAP_KEY=           # Key to provision first platform admin
CORS_ORIGINS=*                    # Comma-separated domains (* only for dev)
MAX_UPLOAD_MB=50
RATE_LIMIT_QUERY=60/minute
RATE_LIMIT_INGEST=10/minute
