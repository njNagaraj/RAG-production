# ==============================================================================
# RAG Pipeline Configuration (local-first: cloud LLM only for final answers)
# ==============================================================================

# Gemini is used ONLY for: (1) final answer generation, (2) optional
# ingestion-time chart/image descriptions when DESCRIBE_IMAGES=true.
GEMINI_API_KEY=your_gemini_api_key_here

# Database (Postgres + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_POOL_MIN=2
DB_POOL_MAX=10

# Providers — everything except generation defaults to local ONNX models
GENERATION_PROVIDER=gemini
EMBEDDING_PROVIDER=local          # local | gemini
RERANKER_PROVIDER=local           # local | cohere | none
EVALUATOR_PROVIDER=local          # local | none

# Local models (CPU-friendly, baked into the Docker image)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Multimodal ingestion: describe charts/photos with Gemini vision (ingest-time only)
DESCRIBE_IMAGES=false

# Chunking: auto (adaptive per doc type) | fixed | page | code | semantic
CHUNKING_STRATEGY=auto
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# Retrieval (retrieve top-20 per method -> fuse -> rerank all -> top 5 to LLM)
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
RRF_CONSTANT=60
HNSW_EF_SEARCH=80

# Semantic cache
SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=168

# Security — REQUIRED in production
# RBAC is DB-backed (users table, per-user API keys, roles: admin/editor/viewer).
# This key creates the initial 'admin' user on first startup. Auth is disabled
# only when no users exist AND this is unset (development only).
ADMIN_BOOTSTRAP_KEY=
CORS_ORIGINS=*                     # comma-separated origins; never * in production
MAX_UPLOAD_MB=50
RATE_LIMIT_QUERY=60/minute
RATE_LIMIT_INGEST=10/minute

# Ingestion worker
UPLOAD_DIR=uploads
WORKER_POLL_SECONDS=2.0
